<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>ua.ivan</groupId>
    <artifactId>gym-integration-tests</artifactId>
    <version>1.0-SNAPSHOT</version>

    <description>Integration tests for Gym and Workload microservices</description>

    <properties>
        <java.version>21</java.version>
        <cucumber.version>7.20.1</cucumber.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>

                    <systemPropertyVariables>
                        <integration.gym-base-url>
                            http://localhost:18080
                        </integration.gym-base-url>

                        <integration.workload-base-url>
                            http://localhost:18081
                        </integration.workload-base-url>

                        <integration.postgres-url>
                            jdbc:postgresql://localhost:15431/gym_db
                        </integration.postgres-url>

                        <integration.postgres-username>
                            postgres
                        </integration.postgres-username>

                        <integration.postgres-password>
                            postgres
                        </integration.postgres-password>

                        <integration.jwt-secret>
                            MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
                        </integration.jwt-secret>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>

                <executions>
                    <execution>
                        <id>clean-compose-before-tests</id>
                        <phase>pre-integration-test</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>
                            <workingDirectory>
                                ${project.basedir}/..
                            </workingDirectory>

                            <executable>docker</executable>

                            <arguments>
                                <argument>compose</argument>

                                <argument>-p</argument>
                                <argument>gym-it</argument>

                                <argument>-f</argument>
                                <argument>docker-compose.test.yaml</argument>

                                <argument>down</argument>
                                <argument>-v</argument>
                                <argument>--remove-orphans</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>start-compose</id>
                        <phase>pre-integration-test</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>
                            <workingDirectory>
                                ${project.basedir}/..
                            </workingDirectory>

                            <executable>docker</executable>

                            <arguments>
                                <argument>compose</argument>

                                <argument>-p</argument>
                                <argument>gym-it</argument>

                                <argument>-f</argument>
                                <argument>docker-compose.test.yaml</argument>

                                <argument>up</argument>
                                <argument>-d</argument>
                                <argument>--build</argument>
                                <argument>--wait</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>stop-compose</id>
                        <phase>post-integration-test</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>
                            <workingDirectory>
                                ${project.basedir}/..
                            </workingDirectory>

                            <executable>docker</executable>

                            <arguments>
                                <argument>compose</argument>

                                <argument>-p</argument>
                                <argument>gym-it</argument>

                                <argument>-f</argument>
                                <argument>docker-compose.test.yaml</argument>

                                <argument>down</argument>
                                <argument>-v</argument>
                                <argument>--remove-orphans</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>